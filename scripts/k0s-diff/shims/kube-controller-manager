#!/bin/sh
# scripts/k0s-diff/shims/kube-controller-manager
#
# Task 5, v4 — the rusternetes-controller-manager flag-adapter. k0s launches
# this file (staged via shims/stage-swap.sh) believing it is the upstream Go
# kube-controller-manager. It translates the k0s controller-manager argv into
# the flags rusternetes-controller-manager (crates/controller-manager/src/main.rs)
# understands, logs every dropped k0s flag, and execs it in **API mode**
# (--kubeconfig present => run_api_mode against k0s's own, still-Go,
# api-server).
#
# Written against the VERBATIM k0s v1.35.5-k0s.0 controller-manager argv in
# SPIKE-FINDINGS.md ("### kube-controller-manager"):
#   /var/lib/k0s/bin/kube-controller-manager --feature-gates= \
#     --profiling=false --terminated-pod-gc-threshold=12500 \
#     --authorization-kubeconfig=/var/lib/k0s/pki/ccm.conf \
#     --kubeconfig=/var/lib/k0s/pki/ccm.conf \
#     --cluster-signing-key-file=/var/lib/k0s/pki/ca.key \
#     --node-cidr-mask-size=24 --bind-address=127.0.0.1 \
#     --service-account-private-key-file=/var/lib/k0s/pki/sa.key \
#     --service-cluster-ip-range=10.96.0.0/12 \
#     --use-service-account-credentials=true --allocate-node-cidrs=true \
#     --cluster-name=k0s --controllers=*,bootstrapsigner,tokencleaner \
#     --leader-elect=true --client-ca-file=/var/lib/k0s/pki/ca.crt \
#     --cluster-signing-cert-file=/var/lib/k0s/pki/ca.crt \
#     --cluster-cidr=10.244.0.0/16 --v=1 \
#     --authentication-kubeconfig=/var/lib/k0s/pki/ccm.conf \
#     --requestheader-client-ca-file=/var/lib/k0s/pki/front-proxy-ca.crt \
#     --root-ca-file=/var/lib/k0s/pki/ca.crt
#
# rusternetes-controller-manager uses clap KEBAB-case flags (verified via
# crates/controller-manager/src/main.rs `Args`):
#   --kubeconfig=X       -> --kubeconfig=X                 (selects API mode)
#   (derived)            -> --api-server-url=<server from the kubeconfig>
#   --cluster-name=X     -> --cluster-name=X                (cloud-provider tag)
#   --leader-elect=true  -> --enable-leader-election
#
# Everything else is DROPPED and logged — these are capability gaps this
# harness exists to surface: --cluster-signing-{key,cert}-file and
# --root-ca-file (no in-process CSR signer over API mode: certificate signing
# goes through the CertificateSigningRequestController, which does not take a
# CA key/cert via flags), --service-account-private-key-file (no SA token
# issuer flag), --node-cidr-mask-size / --allocate-node-cidrs / --cluster-cidr
# (rusternetes' node-IPAM flags exist but are not part of this mapping per the
# task-5 brief — API mode's node IPAM path is unexercised here),
# --service-cluster-ip-range, --use-service-account-credentials, --controllers,
# --client-ca-file, --requestheader-client-ca-file,
# --terminated-pod-gc-threshold, --authentication-kubeconfig,
# --authorization-kubeconfig, --bind-address, --profiling, --v, --feature-gates.
#
# EXPECTED OUTCOME (per task-5 brief): rusternetes' ApiClient has no
# client-cert/mTLS auth (issue #1578), so the controller-manager's API-mode
# calls against k0s's cert-auth api-server are expected to 401 — this shim's
# job is correct WIRING, not convergence.
set -eu

LOG=/tmp/kube-controller-manager-shim.log
: > "$LOG" 2>/dev/null || true
log() { echo "$@" >> "$LOG" 2>/dev/null || true; }
log "=== $(date -u +%FT%TZ) rusternetes-controller-manager adapter shim (pid $$) ==="
log "raw argv: $*"

KUBECONFIG_PATH=""
CLUSTER_NAME=""
LEADER_ELECT=""
DROPPED=""

while [ $# -gt 0 ]; do
  case "$1" in
    --kubeconfig=*)    KUBECONFIG_PATH="${1#*=}" ;;
    --kubeconfig)      KUBECONFIG_PATH="$2"; shift ;;
    --cluster-name=*)  CLUSTER_NAME="${1#*=}" ;;
    --cluster-name)    CLUSTER_NAME="$2"; shift ;;
    --leader-elect=true) LEADER_ELECT=1 ;;
    --leader-elect=*)  : ;;   # false/unset -> no flag, leader election off
    *)                 DROPPED="${DROPPED} $1" ;;
  esac
  shift
done

log "mapped: kubeconfig='$KUBECONFIG_PATH' cluster_name='${CLUSTER_NAME:-<unset>}' leader_elect='${LEADER_ELECT:-<unset>}'"
log "DROPPED k0s flags (unsupported by rusternetes-controller-manager):"
for f in $DROPPED; do log "  $f"; done

# rusternetes-controller-manager's --api-server-url defaults to a hostname
# unreachable here; derive the real endpoint from the kubeconfig's `server:`
# line so it dials k0s's actual api-server (same technique as the v2 kubelet
# and v3 kube-scheduler shims).
API_URL=""
if [ -n "$KUBECONFIG_PATH" ] && [ -f "$KUBECONFIG_PATH" ]; then
  API_URL="$(awk '/^[[:space:]]*server:[[:space:]]*/{print $2; exit}' "$KUBECONFIG_PATH")"
fi
log "derived api-server-url from kubeconfig: '${API_URL:-<none>}'"

[ -n "$KUBECONFIG_PATH" ] || { log "FATAL no --kubeconfig in k0s argv"; echo "kube-controller-manager shim: no --kubeconfig" >&2; exit 1; }

set -- --kubeconfig="$KUBECONFIG_PATH"
[ -n "$API_URL" ]       && set -- "$@" --api-server-url="$API_URL"
[ -n "$CLUSTER_NAME" ]  && set -- "$@" --cluster-name="$CLUSTER_NAME"
[ -n "$LEADER_ELECT" ]  && set -- "$@" --enable-leader-election

# Absolute path: the k0s supervisor launches components with a minimal PATH
# that excludes /usr/local/bin (a bare name yields exit 127 "not found").
RUSTERNETES=/usr/local/bin/rusternetes-controller-manager
log "exec: $RUSTERNETES $*"
exec "$RUSTERNETES" "$@"
